<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<HBox prefHeight="600.0" prefWidth="1000.0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AdminLoginController">
    <stylesheets>
        <URL value="@resources/style.css" />
    </stylesheets>

    <VBox prefWidth="500.0" HBox.hgrow="ALWAYS">
        <ImageView fitHeight="600.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="false">
            <Image url="@resources/luxury hotel.jpg" />
        </ImageView>
    </VBox>

    <VBox alignment="CENTER" prefWidth="500.0" styleClass="content-side" HBox.hgrow="ALWAYS" spacing="0">
        <HBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Button text="← BACK" onAction="#goBack" styleClass="close-button" />
        </HBox>

        <VBox alignment="CENTER" spacing="35" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="60" />
            </padding>

            <VBox alignment="CENTER" spacing="10">
                <Label text="ADMIN PORTAL" styleClass="main-title" />
                <Label text="Authorized Personnel Only" styleClass="subtitle" />
            </VBox>

            <VBox spacing="5" maxWidth="300">
                <Label text="USERNAME" styleClass="field-label" />
                <TextField fx:id="usernameField" styleClass="login-field" promptText="Enter username" />
            </VBox>

            <VBox spacing="5" maxWidth="300">
                <Label text="PASSWORD" styleClass="field-label" />
                <PasswordField fx:id="passwordField" styleClass="login-field" promptText="Enter password" />
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" text="" />

            <Button text="ENTER" onAction="#handleLogin" styleClass="role-button" prefWidth="300" />
        </VBox>
    </VBox>
</HBox>