<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane prefHeight="768.0" prefWidth="1280.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ReceptionistDashboardController">

    <left>
        <VBox prefWidth="410" spacing="0"
              style="-fx-background-color: linear-gradient(to bottom, #141A11, #1A2215); -fx-border-color: transparent rgba(118,128,100,0.1) transparent transparent;">

            <VBox styleClass="sidebar-header" spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 40 25;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="THE FIVE SEASONS" styleClass="sidebar-logo"/>
                    <Label text="🌿" style="-fx-text-fill: #768064; -fx-font-size: 14;"/>
                </HBox>
                <Label fx:id="receptionistNameLabel" styleClass="sidebar-sub" style="-fx-text-fill: #A5D6A7; -fx-font-family: 'Cinzel'; -fx-font-size: 11px;"/>
            </VBox>

            <VBox styleClass="sidebar-nav" spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="20" left="15" right="15"/></padding>
                <Button text="CHECK-IN" onAction="#showCheckIn" styleClass="nav-button" maxWidth="Infinity" />
                <Button text="CHECK-OUT &amp; BILLING" onAction="#showCheckOut" styleClass="nav-button" maxWidth="Infinity" />
                <Button text="ROOM STATUS" onAction="#showRooms" styleClass="nav-button" maxWidth="Infinity" />
                <Region VBox.vgrow="ALWAYS" />
                <Button text="LOGOUT" onAction="#handleLogout" styleClass="logout-button" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="root">
            <VBox alignment="CENTER" spacing="20">
                <Label text="DESK OVERVIEW" styleClass="view-title"/>
                <Label text="SELECT A TERMINAL TO BEGIN" styleClass="view-subtitle"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

