<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="AmenityEditDialogController"
      spacing="10"
      maxWidth="420"
      minWidth="420"
      prefWidth="420"
      maxHeight="-Infinity"
      VBox.vgrow="NEVER"
      styleClass="floating-dialog">

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>

    <!-- TITLE -->
    <Label text="EDIT AMENITY" styleClass="dialog-title"/>

    <Region prefHeight="4"/>

    <!-- COST -->
    <Label text="COST PER USE ($)" styleClass="field-label"/>
    <TextField fx:id="costField" styleClass="login-field"/>

    <!-- AVAILABILITY -->
    <Label text="AVAILABILITY" styleClass="field-label"/>
    <HBox spacing="10">
        <ToggleButton fx:id="availBtn"
                      text="AVAILABLE"
                      styleClass="toggle-button"/>
        <ToggleButton fx:id="unavailBtn"
                      text="UNAVAILABLE"
                      styleClass="toggle-button"/>
    </HBox>

    <!-- IMAGE -->
    <Label text="IMAGE (OPTIONAL)" styleClass="field-label"/>
    <Button fx:id="pickImgBtn"
            text="CHANGE IMAGE"
            onAction="#pickImage"
            styleClass="minimal-button"/>
    <Label fx:id="imgPathLabel"
           text="Current image set"
           style="-fx-text-fill: rgba(218,222,216,0.45); -fx-font-size: 11px; -fx-font-family: 'Montserrat Light';"/>

    <!-- ERROR -->
    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <!-- BUTTONS -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="10"/></padding>
        <Button text="SAVE CHANGES"
                onAction="#confirm"
                styleClass="action-button"/>
        <Button text="CANCEL"
                onAction="#cancel"
                styleClass="cancel-button"/>
    </HBox>

</VBox>
