<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>

<StackPane alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckInViewController">

    <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@/images/hotel_bg.jpg.png" />
        </image>
    </ImageView>

    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;">
        <VBox alignment="CENTER" spacing="35" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="40" bottom="40" left="20" right="150"/>
            </padding>

            <!-- TITLE -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="GUEST ARRIVAL" style="-fx-text-fill: #768064; -fx-letter-spacing: 4px; -fx-font-family: 'Cinzel'; -fx-font-size: 12px;"/>
                <Label text="CHECK-IN DESK" style="-fx-font-family: 'Zaslia'; -fx-font-size: 54px; -fx-text-fill: #DADED8;"/>
            </VBox>

            <!-- SEARCH CARD -->
            <VBox maxWidth="650" spacing="20" alignment="CENTER"
                  style="-fx-background-color: rgba(20, 26, 17, 0.95); -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: rgba(212, 175, 55, 0.5); -fx-border-width: 1.5;">
                <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>
                <effect>
                    <DropShadow color="rgba(212, 175, 55, 0.3)" radius="20" spread="0.4" />
                </effect>

                <Label text="RESERVATION IDENTIFIER" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 10px; -fx-text-fill: #768064; -fx-letter-spacing: 2px;"/>

                <HBox spacing="15" alignment="CENTER">
                    <TextField fx:id="reservationIdField" promptText="Enter ID" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-border-color: rgba(118,128,100,0.3); -fx-padding: 10; -fx-font-family: 'Cinzel';"/>
                    <Button text="VALIDATE" onAction="#handleLookup"
                            style="-fx-background-color: rgba(212, 175, 55, 0.05); -fx-border-color: #d4af37; -fx-border-width: 1; -fx-border-radius: 5; -fx-text-fill: #d4af37; -fx-font-family: 'Cinzel'; -fx-cursor: hand; -fx-pref-width: 120; -fx-pref-height: 40;">
                        <effect>
                            <DropShadow color="black" radius="5" offsetX="2" offsetY="2" />
                        </effect>
                    </Button>
                </HBox>

                <!-- MESSAGE LABEL -->
                <Label fx:id="messageLabel" visible="false" managed="false"
                       style="-fx-font-family: 'Cinzel'; -fx-font-size: 11px; -fx-text-fill: #e57373;" wrapText="true"/>

                <!-- ✅ CONFIRM PAYMENT BUTTON — was completely missing -->
                <Button fx:id="confirmPaymentButton" text="CONFIRM PAYMENT" onAction="#handleConfirmPayment"
                        visible="false" managed="false"
                        style="-fx-background-color: rgba(212, 175, 55, 0.15); -fx-border-color: #d4af37; -fx-border-width: 1; -fx-border-radius: 5; -fx-text-fill: #d4af37; -fx-font-family: 'Cinzel'; -fx-cursor: hand; -fx-pref-width: 220; -fx-pref-height: 40;"/>
            </VBox>

            <!-- RESERVATION DETAILS CARD -->
            <VBox fx:id="reservationInfoBox" visible="false" managed="false" maxWidth="650"
                  style="-fx-background-color: rgba(20, 26, 17, 0.95); -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: rgba(212, 175, 55, 0.5); -fx-border-width: 1.5;">
                <effect>
                    <DropShadow color="rgba(212, 175, 55, 0.3)" radius="20" spread="0.4" />
                </effect>

                <HBox alignment="CENTER" style="-fx-padding: 25 0 15 0;">
                    <Label text="RESERVATION DETAILS" style="-fx-font-family: 'Cinzel'; -fx-font-size: 11px; -fx-text-fill: #d4af37; -fx-letter-spacing: 3px;"/>
                </HBox>

                <VBox spacing="25" style="-fx-padding: 0 40 30 40;">
                    <GridPane vgap="20" hgap="30">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="GUEST NAME" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 9px; -fx-text-fill: #768064;"/>
                            <Label fx:id="guestNameLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 18px; -fx-text-fill: #DADED8;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="ROOM CATEGORY" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 9px; -fx-text-fill: #768064;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="🛌" style="-fx-font-size: 18px;"/>
                                <Label fx:id="roomTypeLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 18px; -fx-text-fill: #DADED8;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"
                              style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: rgba(212, 175, 55, 0.1); -fx-border-radius: 15;">
                            <Label text="STAY DURATION" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 9px; -fx-text-fill: #768064; -fx-padding: 0 0 5 0;"/>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="📅" style="-fx-font-size: 16px;"/>
                                <Label fx:id="checkInDateLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 14px; -fx-text-fill: #DADED8;"/>
                                <Label text="→" style="-fx-text-fill: #d4af37;"/>
                                <Label fx:id="checkOutDateLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 14px; -fx-text-fill: #DADED8;"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="statusLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 10px; -fx-text-fill: #d4af37; -fx-border-color: #d4af37; -fx-border-radius: 3; -fx-padding: 2 8;"/>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>
            </VBox>

            <!-- ✅ ASSIGNMENT BOX — was empty, now has ComboBox + Check-In Button -->
            <VBox fx:id="assignmentBox" visible="false" managed="false" maxWidth="650" spacing="20" alignment="CENTER"
                  style="-fx-background-color: rgba(20, 26, 17, 0.95); -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: rgba(212, 175, 55, 0.5); -fx-border-width: 1.5;">
                <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>
                <effect>
                    <DropShadow color="rgba(212, 175, 55, 0.3)" radius="20" spread="0.4" />
                </effect>

                <Label text="SELECT ROOM" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 10px; -fx-text-fill: #768064; -fx-letter-spacing: 2px;"/>

                <ComboBox fx:id="roomComboBox" promptText="Choose available room..."
                          style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-border-color: rgba(118,128,100,0.3); -fx-font-family: 'Cinzel';"
                          maxWidth="Infinity"/>

                <Button text="COMPLETE CHECK-IN" onAction="#handleCheckIn"
                        style="-fx-background-color: rgba(165, 214, 167, 0.15); -fx-border-color: #A5D6A7; -fx-border-width: 1; -fx-border-radius: 5; -fx-text-fill: #A5D6A7; -fx-font-family: 'Cinzel'; -fx-cursor: hand; -fx-pref-width: 220; -fx-pref-height: 40;"/>
            </VBox>

            <!-- ✅ SUCCESS BOX — was empty, now shows assigned room info -->
            <VBox fx:id="successBox" visible="false" managed="false" maxWidth="650" spacing="15" alignment="CENTER"
                  style="-fx-background-color: rgba(20, 26, 17, 0.95); -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: rgba(165, 214, 167, 0.5); -fx-border-width: 1.5;">
                <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>
                <effect>
                    <DropShadow color="rgba(165, 214, 167, 0.3)" radius="20" spread="0.4" />
                </effect>

                <Label text="✓" style="-fx-font-size: 36px; -fx-text-fill: #A5D6A7;"/>
                <Label text="CHECK-IN SUCCESSFUL" style="-fx-font-family: 'Cinzel'; -fx-font-size: 14px; -fx-text-fill: #A5D6A7; -fx-letter-spacing: 3px;"/>

                <HBox spacing="40" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="ROOM" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 9px; -fx-text-fill: #768064;"/>
                        <Label fx:id="assignedRoomLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 28px; -fx-text-fill: #DADED8;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="FLOOR" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 9px; -fx-text-fill: #768064;"/>
                        <Label fx:id="assignedFloorLabel" style="-fx-font-family: 'Cinzel'; -fx-font-size: 28px; -fx-text-fill: #DADED8;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ✅ RESET BUTTON — was completely missing -->
            <Button fx:id="resetButton" text="NEW CHECK-IN" onAction="#handleReset"
                    visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-border-color: rgba(118,128,100,0.5); -fx-border-width: 1; -fx-border-radius: 5; -fx-text-fill: #768064; -fx-font-family: 'Cinzel'; -fx-cursor: hand; -fx-pref-width: 180; -fx-pref-height: 35;"/>

        </VBox>
    </ScrollPane>
</StackPane>