<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="BookingScreenController"
      stylesheets="@style.css"
      prefWidth="1200" prefHeight="700">

    <!-- ───── LEFT SIDEBAR ───── -->
    <VBox styleClass="sidebar" prefWidth="320" spacing="0">

        <VBox styleClass="sidebar-header" spacing="4">
            <Label text="LUMIÈRE" styleClass="sidebar-logo"/>
            <Label text="HOTEL &amp; RESORTS" styleClass="sidebar-sub"/>
        </VBox>

        <Separator styleClass="sidebar-divider"/>

        <!-- Booking Summary Panel -->
        <VBox spacing="20" style="-fx-padding: 30 25 30 25;">

            <Label text="BOOKING SUMMARY" styleClass="section-title"/>

            <!-- Guest -->
            <VBox spacing="4">
                <Label text="GUEST" styleClass="stat-label"/>
                <Label fx:id="guestNameLabel" text="—" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 14px; -fx-text-fill: #DADED8;"/>
            </VBox>

            <!-- Room Type -->
            <VBox spacing="4">
                <Label text="ROOM TYPE" styleClass="stat-label"/>
                <Label fx:id="roomTypeLabel" text="—" style="-fx-font-family: 'Cinzel'; -fx-font-size: 18px; -fx-text-fill: #DADED8;"/>
            </VBox>

            <!-- Dates -->
            <VBox spacing="4">
                <Label text="CHECK-IN" styleClass="stat-label"/>
                <Label fx:id="checkInLabel" text="—" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 13px; -fx-text-fill: #959581;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="CHECK-OUT" styleClass="stat-label"/>
                <Label fx:id="checkOutLabel" text="—" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 13px; -fx-text-fill: #959581;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="DURATION" styleClass="stat-label"/>
                <Label fx:id="nightsLabel" text="—" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 13px; -fx-text-fill: #959581;"/>
            </VBox>

            <Separator style="-fx-background-color: #4C583E;"/>

            <!-- Price Breakdown -->
            <VBox spacing="8">
                <Label text="PRICE BREAKDOWN" styleClass="stat-label"/>

                <HBox>
                    <Label text="Room cost" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="roomCostLabel" text="\$0.00" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                </HBox>

                <HBox>
                    <Label text="Amenities" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="amenitiesCostLabel" text="\$0.00" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                </HBox>

                <HBox>
                    <Label text="Tax (14%)" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="taxLabel" text="\$0.00" style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                </HBox>

                <Separator style="-fx-background-color: #4C583E;"/>

                <HBox>
                    <Label text="TOTAL" style="-fx-font-family: 'Cinzel'; -fx-font-size: 11px; -fx-text-fill: #DADED8;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="\$0.00" style="-fx-font-family: 'Cinzel'; -fx-font-size: 16px; -fx-text-fill: #DADED8;"/>
                </HBox>
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Back Button -->
        <VBox styleClass="sidebar-footer">
            <Button text="← BACK" styleClass="logout-button" onAction="#goBack" maxWidth="Infinity"/>
        </VBox>
    </VBox>

    <!-- ───── RIGHT CONTENT AREA ───── -->
    <VBox style="-fx-background-color: #F5F0E8;" HBox.hgrow="ALWAYS" spacing="0">

        <!-- Top bar -->
        <HBox style="-fx-padding: 20 30 0 30; -fx-alignment: CENTER_RIGHT;">
            <Button text="✕" styleClass="close-button" onAction="#goBack"/>
        </HBox>

        <!-- Scrollable content -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="40" style="-fx-padding: 20 60 40 60;">

                <!-- Title -->
                <VBox spacing="6">
                    <Label text="Complete Your Booking" styleClass="welcome-title"/>
                    <Label text="SELECT AMENITIES &amp; CONFIRM" styleClass="welcome-sub"/>
                    <Region prefHeight="2" maxHeight="2" style="-fx-background-color: #768064;" maxWidth="400"/>
                </VBox>

                <!-- ── AMENITIES SECTION ── -->
                <VBox spacing="16">
                    <Label text="ADD AMENITIES" styleClass="section-title"/>
                    <Label text="Select the amenities you'd like in your room. These will be added to your total." styleClass="explanation-text" style="-fx-max-width: 600px;"/>

                    <FlowPane fx:id="amenitiesContainer" hgap="12" vgap="12"/>
                </VBox>

                <!-- ── SELECTED AMENITIES ── -->
                <VBox spacing="12" fx:id="selectedAmenitiesSection">
                    <Label text="SELECTED AMENITIES" styleClass="section-title"/>
                    <VBox fx:id="selectedAmenitiesContainer" spacing="8"/>
                </VBox>

                <!-- ── PAYMENT METHOD ── -->
                <VBox spacing="16">
                    <Label text="PAYMENT METHOD" styleClass="section-title"/>

                    <HBox spacing="12">
                        <Button fx:id="cashBtn" text="CASH" styleClass="action-button" onAction="#selectCash" prefWidth="150"/>
                        <Button fx:id="onlineBtn" text="ONLINE" styleClass="action-button" onAction="#selectOnline" prefWidth="150"/>
                        <Button fx:id="creditBtn" text="CREDIT CARD" styleClass="action-button" onAction="#selectCredit" prefWidth="150"/>
                    </HBox>

                    <Label fx:id="selectedMethodLabel" text="No payment method selected."
                           style="-fx-font-family: 'Montserrat Light'; -fx-font-size: 12px; -fx-text-fill: #959581;"/>
                </VBox>

                <!-- ── ERROR LABEL ── -->
                <Label fx:id="errorLabel" text="" styleClass="error-label"/>

                <!-- ── CONFIRM BUTTON ── -->
                <Button text="CONFIRM RESERVATION"
                        styleClass="action-button"
                        onAction="#handleConfirm"
                        prefWidth="300" prefHeight="50"
                        style="-fx-font-size: 13px;"/>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>