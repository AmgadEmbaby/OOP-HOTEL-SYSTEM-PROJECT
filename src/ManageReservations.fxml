<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ManageReservationsController">

    <stylesheets>
        <URL value="@/style.css"/>
    </stylesheets>

    <VBox spacing="0" styleClass="rooms-view">


        <HBox alignment="CENTER_LEFT" styleClass="view-header" spacing="20">
            <padding><Insets top="30" right="40" bottom="20" left="40"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="RESERVATIONS MANAGEMENT" styleClass="view-title"/>
                <Label text="Guest bookings and stay records" styleClass="view-subtitle"/>
            </VBox>
        </HBox>

        <Region prefHeight="1" maxWidth="Infinity"
                style="-fx-background-color: rgba(118,128,100,0.2);"/>


        <HBox spacing="0" VBox.vgrow="ALWAYS">


            <VBox spacing="12" prefWidth="420" minWidth="420"
                  style="-fx-border-color: rgba(118,128,100,0.2); -fx-border-width: 0 1 0 0;">
                <padding><Insets top="24" right="20" bottom="24" left="40"/></padding>

                <Label text="ALL RESERVATIONS" styleClass="section-title"/>

                <TextField fx:id="searchField"
                           promptText="Search guest, status..."
                           styleClass="login-field"
                           onKeyReleased="#filterReservations"/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="scroll-pane"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="reservationsContainer" spacing="8">
                        <padding><Insets top="8" right="4" bottom="8" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>


            <VBox fx:id="detailsPanel" spacing="14" HBox.hgrow="ALWAYS">
                <padding><Insets top="24" right="40" bottom="24" left="40"/></padding>

                <Label text="RESERVATION DETAILS" styleClass="section-title"/>

                <Label fx:id="detailGuest" text="Select a reservation"
                       styleClass="view-title"
                       style="-fx-font-size: 32px;"/>

                <Region prefHeight="4"/>

                <Label text="ROOM TYPE" styleClass="field-label"/>
                <Label fx:id="detailRoom" text="—" styleClass="room-card-sub"/>

                <Label text="DATES" styleClass="field-label"/>
                <Label fx:id="detailDates" text="—" styleClass="room-card-sub"/>

                <Label text="STATUS" styleClass="field-label"/>
                <Label fx:id="detailStatus" text="—" styleClass="room-card-sub"/>

                <Label text="PAYMENT METHOD" styleClass="field-label"/>
                <Label fx:id="detailPayment" text="—" styleClass="room-card-sub"/>

            </VBox>

        </HBox>
    </VBox>

</StackPane>