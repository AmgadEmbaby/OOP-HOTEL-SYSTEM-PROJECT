<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="AdminController"
      styleClass="root"
      prefHeight="800.0"
      prefWidth="1200.0">

   <stylesheets>
      <URL value="@/style.css"/>
   </stylesheets>

   <!-- ================= SIDEBAR ================= -->
   <StackPane prefWidth="300" minHeight="800" style="-fx-background-color: linear-gradient(to bottom, #0E160B, #121B0E, #162012); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 30, 0.2, 4, 0);">

      <!-- Velvet texture overlay -->
      <ImageView fitWidth="300"
                 fitHeight="1400"
                 preserveRatio="false"
                 opacity="0.25"
                 pickOnBounds="false"
                 mouseTransparent="true"
                 StackPane.alignment="CENTER">

      </ImageView>

      <!-- Sidebar -->
      <VBox styleClass="sidebar" prefWidth="300" minHeight="800">

         <!-- Logo -->
         <VBox alignment="CENTER" styleClass="sidebar-header" spacing="5">
            <Label text="THE FIVE" styleClass="sidebar-logo"/>
            <Label text="SEASONS" styleClass="sidebar-logo"/>
            <Label text="ADMIN PANEL" styleClass="sidebar-sub"/>
         </VBox>

         <Region prefHeight="20"/>

         <!-- Navigation -->
         <VBox spacing="6" styleClass="sidebar-nav">
            <Label text="OVERVIEW" styleClass="sidebar-section"/>
            <Button text="Dashboard" styleClass="nav-button" onAction="#showHome"/>
            <Region prefHeight="10"/>
            <Label text="MANAGEMENT" styleClass="sidebar-section"/>
            <Button text="Rooms" styleClass="nav-button" onAction="#showRooms"/>
            <Button text="Amenities" styleClass="nav-button" onAction="#showAmenities"/>
            <Button text="Room Types" styleClass="nav-button" onAction="#showRoomTypes"/>
            <Region prefHeight="10"/>
            <Label text="MONITORING" styleClass="sidebar-section"/>
            <Button text="Reservations" styleClass="nav-button" onAction="#showReservations"/>
            <Button text="Guests" styleClass="nav-button" onAction="#showGuests"/>
         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- Logout -->
         <VBox styleClass="sidebar-footer" VBox.vgrow="NEVER">
            <padding><Insets bottom="30" top="10" left="10" right="10"/></padding>
            <Button text="Logout" styleClass="logout-button" onAction="#logout" maxWidth="Infinity"/>
         </VBox>

      </VBox>
   </StackPane>

   <!-- ================= MAIN CONTENT ================= -->
   <StackPane HBox.hgrow="ALWAYS"
              styleClass="content-area dashboard-shell">

      <!-- BOTANICAL OVERLAY -->
      <ImageView fitWidth="500"
                 preserveRatio="true"
                 opacity="0.10"
                 pickOnBounds="false"
                 mouseTransparent="true"
                 StackPane.alignment="BOTTOM_RIGHT">
         <Image url="@Luxury_Hotel.jpg" />
      </ImageView>

      <!-- Scrollable dashboard -->
      <ScrollPane fitToWidth="true" styleClass="content-area">
         <VBox spacing="35">
            <padding>
               <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- ========== HERO SECTION ========== -->
            <VBox spacing="8">
               <Label text="Good Evening," styleClass="welcome-sub"/>
               <Label fx:id="adminNameLabel" text="Admin" styleClass="welcome-title"/>
               <Label text="The Five Seasons is operating smoothly today." styleClass="subtitle"/>
            </VBox>

            <!-- ========== STATUS STRIP ========== -->
            <HBox spacing="22">
               <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200">
                  <Label text="ROOMS" styleClass="stat-label"/>
                  <Label fx:id="totalRoomsLabel" text="0" styleClass="stat-number"/>
               </VBox>
               <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200">
                  <Label text="AVAILABLE" styleClass="stat-label"/>
                  <Label fx:id="availableRoomsLabel" text="0" styleClass="stat-number"/>
               </VBox>
               <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200">
                  <Label text="GUESTS" styleClass="stat-label"/>
                  <Label fx:id="totalGuestsLabel" text="0" styleClass="stat-number"/>
               </VBox>
               <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200">
                  <Label text="RESERVATIONS" styleClass="stat-label"/>
                  <Label fx:id="totalReservationsLabel" text="0" styleClass="stat-number"/>
               </VBox>
            </HBox>

            <!-- ========== TONIGHT ARRIVALS ========== -->
            <VBox spacing="10">
               <Label text="TONIGHT'S ARRIVALS" styleClass="section-title"/>
               <ScrollPane fitToHeight="true" hbarPolicy="ALWAYS" vbarPolicy="NEVER">
                  <HBox fx:id="arrivalsContainer" spacing="15">
                     <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                     </padding>
                  </HBox>
               </ScrollPane>
            </VBox>

            <!-- ========== ACTIVITY FEED ========== -->
            <VBox spacing="10">
               <Label text="ACTIVITY FEED" styleClass="section-title"/>
               <VBox fx:id="activityFeedContainer" spacing="8"/>
            </VBox>

            <!-- ========== QUICK ACTIONS ========== -->
            <VBox spacing="10">
               <Label text="QUICK ACTIONS" styleClass="section-title"/>
               <HBox spacing="10">
                  <Button text="+ Room" styleClass="action-button" onAction="#showRooms"/>
                  <Button text="+ Amenity" styleClass="action-button" onAction="#showAmenities"/>
                  <Button text="+ Room Type" styleClass="action-button" onAction="#showRoomTypes"/>
               </HBox>
            </VBox>

         </VBox>
      </ScrollPane>

      <!-- Minimize button ON TOP -->
      <HBox alignment="TOP_RIGHT"
            StackPane.alignment="TOP_RIGHT"
            style="-fx-padding: 15 20 0 0;"
            mouseTransparent="false">
         <Button text="—"
                 onAction="#minimizeApp"
                 styleClass="window-button"/>
      </HBox>

   </StackPane>

</HBox>
