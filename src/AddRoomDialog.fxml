<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="AddRoomDialogController"
      spacing="10"
      styleClass="dialog-box"
      maxWidth="340"
      minHeight="0"
      prefHeight="-1"
      maxHeight="260">

    <padding>
        <Insets top="18" right="24" bottom="18" left="24"/>
    </padding>

    <Label text="ADD NEW ROOM" styleClass="dialog-title"/>

    <Region prefHeight="1"
            style="-fx-background-color: rgba(118,128,100,0.3);"/>

    <VBox spacing="3">
        <Label text="FLOOR NUMBER" styleClass="field-label"/>
        <TextField fx:id="floorField"
                   styleClass="login-field"
                   promptText="e.g. 1"/>
    </VBox>

    <VBox spacing="3">
        <Label text="ROOM TYPE" styleClass="field-label"/>
        <ComboBox fx:id="roomTypeCombo"
                  styleClass="combo-field"
                  maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="dialogErrorLabel" styleClass="error-label" text=""/>

    <HBox spacing="10">
        <Button text="CREATE ROOM"
                onAction="#createRoom"
                styleClass="action-button"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity"/>
        <Button text="CANCEL"
                onAction="#closeDialog"
                styleClass="cancel-button"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity"/>
    </HBox>

</VBox>
