<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RoomSelectionController"
      prefHeight="700.0" prefWidth="1200.0" styleClass="root" spacing="20">

    <stylesheets>
        <URL value="@resources/style.css" />
    </stylesheets>

    <HBox alignment="TOP_RIGHT">
        <padding><Insets top="20" right="20" /></padding>
        <Button text="← BACK TO DASHBOARD" onAction="#goBack" styleClass="close-button" />
    </HBox>

    <VBox alignment="CENTER" spacing="10">
        <padding><Insets bottom="20" /></padding>
        <Label text="AVAILABLE SUITES" styleClass="main-title" />
        <Label fx:id="datesLabel" text="Loading dates..." styleClass="subtitle" />
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="roomContainer" alignment="CENTER" hgap="40" vgap="40">
                <padding><Insets top="20" bottom="60" left="40" right="40" /></padding>
            </FlowPane>
        </content>
    </ScrollPane>

</VBox>