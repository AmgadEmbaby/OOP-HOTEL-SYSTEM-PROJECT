<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ManageGuestsController">

    <stylesheets>
        <URL value="@/style.css"/>
    </stylesheets>

    <VBox spacing="0" styleClass="rooms-view">


        <HBox alignment="CENTER_LEFT" styleClass="view-header" spacing="20">
            <padding><Insets top="30" right="40" bottom="20" left="40"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="GUEST REGISTRY" styleClass="view-title"/>
                <Label text="VIP member database and guest profiles" styleClass="view-subtitle"/>
            </VBox>
        </HBox>

        <Region prefHeight="1" maxWidth="Infinity"
                style="-fx-background-color: rgba(118,128,100,0.2);"/>


        <HBox spacing="0" VBox.vgrow="ALWAYS">


            <VBox spacing="12" prefWidth="420" minWidth="420"
                  style="-fx-border-color: rgba(118,128,100,0.2); -fx-border-width: 0 1 0 0;">
                <padding><Insets top="24" right="20" bottom="24" left="40"/></padding>

                <Label text="ALL GUESTS" styleClass="section-title"/>

                <TextField fx:id="searchField"
                           promptText="Search by name or city..."
                           styleClass="login-field"
                           onKeyReleased="#filterGuests"/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="scroll-pane"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="guestsContainer" spacing="8">
                        <padding><Insets top="8" right="4" bottom="8" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>


            <VBox fx:id="detailsPanel" spacing="14" HBox.hgrow="ALWAYS">
                <padding><Insets top="24" right="40" bottom="24" left="40"/></padding>

                <Label text="GUEST PROFILE" styleClass="section-title"/>


                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label fx:id="avatarLabel" text="N"
                           style="-fx-background-color: rgba(90,140,90,0.25);
                                  -fx-background-radius: 50;
                                  -fx-min-width: 64; -fx-min-height: 64;
                                  -fx-max-width: 64; -fx-max-height: 64;
                                  -fx-alignment: center;
                                  -fx-font-family: 'Zaslia';
                                  -fx-font-size: 28px;
                                  -fx-text-fill: #d7dfd0;
                                  -fx-border-color: rgba(118,128,100,0.3);
                                  -fx-border-radius: 50;
                                  -fx-border-width: 1;"/>
                    <VBox spacing="4">
                        <Label fx:id="detailName" text="Select a guest"
                               styleClass="view-title"
                               style="-fx-font-size: 32px;"/>
                        <Label fx:id="detailCity" text="—"
                               styleClass="room-card-sub"/>
                    </VBox>
                </HBox>

                <Region prefHeight="8"/>

                <Label text="DATE OF BIRTH" styleClass="field-label"/>
                <Label fx:id="detailDob" text="—" styleClass="room-card-sub"/>

                <Label text="GENDER" styleClass="field-label"/>
                <Label fx:id="detailGender" text="—" styleClass="room-card-sub"/>

                <Label text="BALANCE" styleClass="field-label"/>
                <Label fx:id="detailBalance" text="—" styleClass="status-available"/>

                <Label text="TOTAL RESERVATIONS" styleClass="field-label"/>
                <Label fx:id="detailReservations" text="—" styleClass="room-card-sub"/>

                <Region prefHeight="8"/>


                <Label text="RESERVATION HISTORY" styleClass="section-title"/>
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="scroll-pane"
                            prefHeight="200"
                            maxHeight="200">
                    <VBox fx:id="guestReservationsContainer" spacing="6">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>

            </VBox>
        </HBox>
    </VBox>
</StackPane>