<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="title-label" style="-fx-font-size: 32px;" text="Room Availability &amp; Status" />
    <TableView prefHeight="400.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Room Number" prefWidth="120.0" />
            <TableColumn text="Floor" prefWidth="100.0" />
            <TableColumn text="Type" prefWidth="150.0" />
            <TableColumn text="Status" prefWidth="150.0" />
            <TableColumn text="Current Guest" prefWidth="150.0" />
        </columns>
    </TableView>
</VBox>