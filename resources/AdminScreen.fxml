<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="AdminController"
      prefHeight="700.0" prefWidth="1200.0" styleClass="root">
   <stylesheets>
      <URL value="@/style.css" />
   </stylesheets>

   <!-- SIDEBAR -->
   <VBox prefWidth="320" styleClass="sidebar" spacing="0">

      <!-- Logo/Title area -->
      <VBox alignment="CENTER" styleClass="sidebar-header" prefHeight="120">
         <Label text="THE FIVE" styleClass="sidebar-logo" />
         <Label text="SEASONS" styleClass="sidebar-logo" />
         <Label text="ADMIN" styleClass="sidebar-sub" />
      </VBox>

      <!-- Divider -->
      <Region prefHeight="1" prefWidth="320" styleClass="sidebar-divider" />

      <!-- Nav Items -->
      <VBox VBox.vgrow="ALWAYS" spacing="5" styleClass="sidebar-nav">
         <padding><Insets top="20" /></padding>
         <Button text="  ⌂  HOME" onAction="#showHome" styleClass="nav-button" maxWidth="Infinity" fx:id="homeBtn" />
         <Button text="  ▦  ROOMS" onAction="#showRooms" styleClass="nav-button" maxWidth="Infinity" />
         <Button text="  ✦  AMENITIES" onAction="#showAmenities" styleClass="nav-button" maxWidth="Infinity" />
         <Button text="  ◈  ROOM TYPES" onAction="#showRoomTypes" styleClass="nav-button" maxWidth="Infinity" />
         <Button text="  ✦  GUESTS" onAction="#showGuests" styleClass="nav-button" maxWidth="Infinity" />
         <Button text="  ≡  RESERVATIONS" onAction="#showReservations" styleClass="nav-button" maxWidth="Infinity" />
      </VBox>

      <!-- Logout at bottom -->
      <VBox alignment="BOTTOM_CENTER" styleClass="sidebar-footer">
         <Region prefHeight="1" prefWidth="280" styleClass="sidebar-divider" />
         <padding><Insets bottom="20" top="10" /></padding>
         <Button text="  ⇤  LOGOUT" onAction="#logout" styleClass="logout-button" maxWidth="Infinity" />
      </VBox>

   </VBox>

   <!-- MAIN CONTENT -->
   <StackPane HBox.hgrow="ALWAYS" fx:id="contentArea" styleClass="content-area">

      <HBox alignment="TOP_RIGHT" style="-fx-padding: 10 15 0 0;">
         <Button text="⊡" onAction="#minimizeApp" styleClass="close-button" />
      </HBox>
      <VBox fx:id="homeContent" spacing="40" alignment="CENTER">
         <padding><Insets top="60" left="80" right="80" bottom="40" /></padding>

         <!-- Welcome centered -->
         <VBox alignment="CENTER" spacing="8">
            <Label text="Welcome back," styleClass="welcome-sub" />
            <Label fx:id="adminNameLabel" text="Admin" styleClass="welcome-title" />
            <Region prefHeight="1" prefWidth="400" styleClass="gold-line" />
         </VBox>

         <!-- Quick Summary title -->
         <Label text="QUICK SUMMARY" styleClass="section-title" />

         <!-- 2x2 Stat Cards -->
         <VBox spacing="20" alignment="CENTER">
            <HBox spacing="20" alignment="CENTER">
               <VBox styleClass="stat-card" prefWidth="220" prefHeight="130" alignment="CENTER" spacing="10">
                  <Label text="TOTAL ROOMS" styleClass="stat-label" />
                  <Label fx:id="totalRoomsLabel" text="0" styleClass="stat-number" />
               </VBox>
               <VBox styleClass="stat-card" prefWidth="220" prefHeight="130" alignment="CENTER" spacing="10">
                  <Label text="AVAILABLE ROOMS" styleClass="stat-label" />
                  <Label fx:id="availableRoomsLabel" text="0" styleClass="stat-number" />
               </VBox>
            </HBox>
            <HBox spacing="20" alignment="CENTER">
               <VBox styleClass="stat-card" prefWidth="220" prefHeight="130" alignment="CENTER" spacing="10">
                  <Label text="TOTAL GUESTS" styleClass="stat-label" />
                  <Label fx:id="totalGuestsLabel" text="0" styleClass="stat-number" />
               </VBox>
               <VBox styleClass="stat-card" prefWidth="220" prefHeight="130" alignment="CENTER" spacing="10">
                  <Label text="RESERVATIONS" styleClass="stat-label" />
                  <Label fx:id="totalReservationsLabel" text="0" styleClass="stat-number" />
               </VBox>
            </HBox>
         </VBox>

         <!-- Quick Actions -->
         <VBox spacing="15" alignment="CENTER">
            <Label text="QUICK ACTIONS" styleClass="section-title" />
            <HBox spacing="15" alignment="CENTER">
               <Button text="+ ADD ROOM" onAction="#showRooms" styleClass="action-button" />
               <Button text="+ ADD AMENITY" onAction="#showAmenities" styleClass="action-button" />
               <Button text="+ ADD ROOM TYPE" onAction="#showRoomTypes" styleClass="action-button" />
            </HBox>
         </VBox>

      </VBox>

   </StackPane>

</HBox>