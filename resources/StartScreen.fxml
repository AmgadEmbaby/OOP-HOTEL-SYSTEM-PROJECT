<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="40.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Navigator">
   <children>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label style="-fx-font-size: 56px;" styleClass="title-label" text="The Five Seasons" />
            <Label style="-fx-font-size: 18px; -fx-text-fill: #959581; -fx-font-style: italic;" text="Luxury Hotel Management System" />
         </children>
      </VBox>
      <Label style="-fx-font-size: 20px;" styleClass="label" text="Please select your portal:" />
      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#guestChoice" prefHeight="50.0" prefWidth="180.0" text="Guest Portal" />
            <Button mnemonicParsing="false" onAction="#ReceptionistChoice" prefHeight="50.0" prefWidth="180.0" text="Reception Desk" />
            <Button mnemonicParsing="false" onAction="#adminChoice" prefHeight="50.0" prefWidth="180.0" text="Admin Portal" />
         </children>
      </HBox>
   </children>
</VBox>