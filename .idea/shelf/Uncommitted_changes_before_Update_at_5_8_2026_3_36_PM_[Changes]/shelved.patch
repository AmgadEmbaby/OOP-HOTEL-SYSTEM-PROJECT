+            updateCostField.clear();
+            refreshAmenityList();
+        } catch (NumberFormatException e) {
+            updateCostMessage.setText("Enter a valid number.");
+        } catch (Exception e) {
+            updateCostMessage.setText("Error: " + e.getMessage());
+        }
+    }
+
+    // ────────────────────────────────────────────────────
